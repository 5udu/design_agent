# Copy to .env.production. Generate a random HEX database password and use the
# same value in POSTGRES_PASSWORD and DATABASE_URL. Never commit the real file.
APP_ENV_FILE=.env.production
POSTGRES_PASSWORD=replace_with_random_hex_password
DATABASE_URL=postgresql://design:replace_with_random_hex_password@db:5432/design
SITE_ADDRESS=design.example.com
APP_ORIGIN=https://design.example.com
COOKIE_SECURE=true
DEPLOYMENT_MODE=production
DEEPSEEK_API_KEY=
SEEDREAM_API_KEY=
WORKER_CONCURRENCY=3
GLOBAL_CONCURRENCY=5
USER_CONCURRENCY=2
WORKER_LEASE_SECONDS=60
DB_POOL_SIZE=20
SESSION_TTL_SECONDS=28800
SSE_POLL_SECONDS=2
# Optional OCR service accessible from the worker container.
OCR_URL=http://host.docker.internal:8766
